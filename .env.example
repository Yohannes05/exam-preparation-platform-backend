APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# For Supabase PostgreSQL in production, replace the sqlite setting above and
# copy these values from Supabase Dashboard → Connect. Use direct connections
# when the app host supports IPv6; otherwise choose the Session pooler.
# DB_CONNECTION=pgsql
# DB_HOST=your-supabase-host
# DB_PORT=5432
# DB_DATABASE=postgres
# DB_USERNAME=your-supabase-username
# DB_PASSWORD=your-supabase-database-password
# DB_SSLMODE=require

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Supabase Storage for production lesson PDFs and public note images.
# Create a public `lesson-files` bucket in Supabase Storage and use the
# server-side service_role key here (never expose it in browser code).
SUPABASE_URL=
SUPABASE_STORAGE_BUCKET=lesson-files
SUPABASE_STORAGE_SERVICE_KEY=

VITE_APP_NAME="${APP_NAME}"

# Telegram bot (student interface)
# Get a token from @BotFather, then:  php artisan telegram:set-webhook
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_CHANNEL_USERNAME=exitexamprep
TELEGRAM_CHANNEL_URL=https://t.me/exitexamprep
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_ACTIVATION_PRICE=200
TELEGRAM_TELEBIRR_NUMBER=
TELEGRAM_CBE_ACCOUNT=
TELEGRAM_CBE_ACCOUNT_NAME=
TELEGRAM_SUPPORT_USERNAME=
TELEGRAM_FREE_DAILY_LIMIT=10
TELEGRAPH_ACCESS_TOKEN=
# Run the bot locally without a public webhook URL:
#   php artisan telegram:poll
TELEGRAM_MOCK=false
